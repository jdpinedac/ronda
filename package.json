{
  "name": "ronda",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "description": "See who holds the floor. Speaker diarization that runs entirely in your browser.",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/fetch-models.mjs && vite",
    "build": "node scripts/fetch-models.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "bench": "vitest run --config bench/vitest.config.mts",
    "bench:offline": "vitest run --config bench/vitest.config.mts bench/offline.report.ts",
    "lint": "eslint . && tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "onnxruntime-web": "^1.29.0"
  }
}
